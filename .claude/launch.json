{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "abra-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "abraxus-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "hermes-theme/extended"
      ],
      "port": 8765
    },
    {
      "name": "abra-motion",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "abra-motion"
      ],
      "port": 8766
    }
  ]
}
