{
  "$comment": "Единый источник цветов ABRAXUS для Hermes. STANDARD (YAML) ссылается на эти токены комментарием «# token: <имя>», EXTENDED будет читать файл напрямую. Новых цветов здесь нет: base — значения, которые стоят на сайте или в abra-tokens.css, derived — их смеси по формуле «фон + (цвет − фон) × alpha», как блок [SHEETS] в abra-tokens.css. Проверка: python3 hermes-theme/standard/check.py",
  "base": {
    "bg":        { "value": "#0C0B09", "source": "src/style.css", "match": "--bg: #0C0B09",     "role": "основной фон" },
    "bg-warm":   { "value": "#131210", "source": "src/style.css", "match": "--bg-warm: #131210", "role": "карточки, плашки, поля" },
    "text":      { "value": "#CEC9C3", "source": "src/style.css", "match": "--text: #CEC9C3",   "role": "основной текст" },
    "snow":      { "value": "#EDEBE6", "source": "src/style.css", "match": "--snow: #EDEBE6",   "role": "заголовки, важные лейблы" },
    "accent":    { "value": "#B87333", "source": "src/style.css", "match": "--accent: #B87333", "role": "медь — единственный акцент: фокус, результат, метки" },
    "ok":        { "value": "#7C9A6E", "source": "abra-tokens.css", "match": "--abra-ok:#7C9A6E",   "role": "успех (блок [TARGET])" },
    "warn":      { "value": "#C9A24B", "source": "abra-tokens.css", "match": "--abra-warn:#C9A24B", "role": "предупреждение (блок [TARGET])" },
    "bad":       { "value": "#B5563F", "source": "abra-tokens.css", "match": "--abra-bad:#B5563F",  "role": "ошибка — только заливки и крупные знаки, текстом 4,09:1" },
    "info":      { "value": "#6E86A0", "source": "abra-tokens.css", "match": "--abra-info:#6E86A0", "role": "справочная информация (блок [TARGET])" }
  },
  "derived": {
    "line":          { "value": "#1A1816", "mix": ["text", "bg", 0.07], "match": "--abra-sh-line:#1A1816",        "role": "--border: декоративные линии" },
    "line-surface":  { "value": "#2B2927", "mix": ["text", "bg", 0.16], "match": null,                            "role": "--border-surface: края плашек" },
    "line-control":  { "value": "#63615D", "mix": ["text", "bg", 0.45], "match": "--abra-sh-line-strong:#63615D", "role": "--border-control: поля, чекбоксы (3,15:1)" },
    "muted":         { "value": "#84817C", "mix": ["text", "bg", 0.62], "match": "--abra-sh-text-muted:#84817C",  "role": "второстепенный текст (5,07:1)" },
    "accent-tint":   { "value": "#D0A984", "mix": ["accent", "snow", 0.55], "match": "--abra-sh-series-5:#D0A984", "role": "светлая медь — строки в коде, вторая ступень акцента" },
    "accent-fill":   { "value": "#2B1E11", "mix": ["accent", "bg", 0.18], "match": "--abra-sh-fill-accent:#2B1E11", "role": "медная подложка: выделение, активная строка" },
    "ok-fill":       { "value": "#20251B", "mix": ["ok", "bg", 0.18],   "match": "--abra-sh-fill-ok:#20251B",     "role": "заливка добавленной строки diff" },
    "bad-fill":      { "value": "#2A1813", "mix": ["bad", "bg", 0.18],  "match": "--abra-sh-fill-bad:#2A1813",    "role": "заливка удалённой строки diff" },
    "bad-text":      { "value": "#C07460", "mix": ["snow", "bad", 0.20], "match": null,                           "role": "ошибка текстом: --abra-bad, поднятый к --snow до 5,54:1" }
  }
}
